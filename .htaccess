# Silver Star Platform - LiteSpeed & Apache Configuration
# Routes all public requests through index.php for SPA routing and asset resolution

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow direct access to deploy-hook.php
    RewriteRule ^deploy-hook\.php$ - [L]

    # If requested file exists, serve directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Route all other requests (SPA pages, assets, API) to index.php
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
