# Silver Star Platform - LiteSpeed & Apache Configuration
DirectoryIndex index.html index.php

<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow direct access to deploy-hook.php and db-admin.php
    RewriteRule ^deploy-hook\.php$ - [L]
    RewriteRule ^db-admin\.php$ - [L]

    # Route /api/ calls through index.php (Reverse proxy to Node.js backend port 5000)
    RewriteRule ^api/(.*)$ index.php [L,QSA]

    # If requested physical file exists, serve it directly (CSS, JS, images)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Sub-app SPA routing fallbacks for clean URLs without port numbers
    RewriteRule ^super-admin(/.*)?$ /super-admin/index.html [L]
    RewriteRule ^admin(/.*)?$ /admin/index.html [L]
    RewriteRule ^hr-admin(/.*)?$ /hr-admin/index.html [L]
    RewriteRule ^hr(/.*)?$ /hr/index.html [L]
    RewriteRule ^ops-admin(/.*)?$ /ops-admin/index.html [L]
    RewriteRule ^ops(/.*)?$ /ops/index.html [L]
    RewriteRule ^client-portal(/.*)?$ /client-portal/index.html [L]
    RewriteRule ^client(/.*)?$ /client/index.html [L]
    RewriteRule ^field-officer(/.*)?$ /field-officer/index.html [L]
    RewriteRule ^employee(/.*)?$ /employee/index.html [L]

    # Public Smart ID Card & Personnel Verification Badge
    RewriteRule ^verify(/.*)?$ /verify/index.html [L]
    RewriteRule ^emp(/.*)?$ /verify/index.html [L]
    RewriteRule ^ss-[a-zA-Z0-9_-]+$ /verify/index.html [L]

    # If requested directory exists, serve directly
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Default fallback to master portal hub
    RewriteRule ^ index.html [L]
</IfModule>
